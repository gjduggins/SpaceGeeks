@model SpaceGeeks.Models.NasaMission

<div class="mission-card">
    <h2>@Model.Name</h2>
    <img src="@Model.ImagePath"
         alt="@Model.Name"
         onerror="this.onerror=null; this.src='/images/placeholder.svg';" />
    <p>@Model.Description</p>
    <span class="mission-status @Model.Status">@Model.Status</span>
    <ul class="mission-facts">
        <li>
            <strong>Launch Date:</strong>
            <span>@Model.LaunchDate.ToString("MMMM dd, yyyy")</span>
        </li>
        @if (Model.EndDate.HasValue)
        {
            <li>
                <strong>End Date:</strong>
                <span>@Model.EndDate.Value.ToString("MMMM dd, yyyy")</span>
            </li>
        }
    </ul>
</div>